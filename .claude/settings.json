{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh" } ] },
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-sources.sh" } ] }
    ]
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Bash(rm -rf:*)"]
  }
}
