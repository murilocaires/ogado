// T-04 (ADR-0010): contas, sessões e fazenda (tenant).
// Convenção de entidade sincronizável (ADR-0007) aplicada à Fazenda: id UUID, version, updatedAt
// do servidor, deletedAt (tombstone). Entidades de negócio futuras repetem a convenção + fazendaId.
generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  // normalizado (trim + minúsculas) na borda; único
  email        String   @unique
  // string PHC argon2id; nulo quando o usuário só entra com Google (T-16)
  senhaHash    String?
  // nome de exibição (RF-004); opcional até o usuário preencher na Conta
  nome         String?
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  sessoes Sessao[]
  fazenda Fazenda?
}

model Sessao {
  // parte pública do token (id.segredo); o segredo nunca é guardado, só o SHA-256 dele (hex)
  id                  String   @id
  segredoHash         String
  usuarioId           String   @db.Uuid
  criadaEm            DateTime @default(now()) @db.Timestamptz(3)
  ultimaVerificacaoEm DateTime @default(now()) @db.Timestamptz(3)
  // teto absoluto
  expiraEm            DateTime @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Fazenda {
  id        String    @id @default(uuid()) @db.Uuid
  // único = 1 fazenda por conta na v1 (v1.1: remover a unicidade)
  donoId    String    @unique @db.Uuid
  // opcional até o onboarding (T-05)
  nome      String?
  // área em hectares (RF-011); string decimal na API
  areaHa    Decimal?  @db.Decimal(12, 2)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  dono Usuario @relation(fields: [donoId], references: [id], onDelete: Restrict)

  lotes         Lote[]
  cenarios      Cenario[]
  recriaEntrada RecriaEntrada?

  @@index([updatedAt])
}

// E3 (ADR-0007, ADR-0011 §3-4): dados do site no servidor, por fazenda. Convenção sincronizável:
// `id` UUID gerado pelo cliente, `version` e `updatedAt` só do servidor, `deletedAt` = lápide.
// Decimais: Decimal exato (ADR-0003); a API os trafega como string canônica.
enum LoteTipo {
  compra
  venda
}

enum ModoPeso {
  total
  medio
  individual
}

enum BaseArroba {
  vivo
  carcaca
}

model Lote {
  id              String     @id @db.Uuid
  fazendaId       String     @db.Uuid
  tipo            LoteTipo
  // sequencial por fazenda + tipo, atribuído pelo servidor; lápides mantêm o número (nunca reutiliza)
  numero          Int
  categoria       String
  data            DateTime?  @db.Date
  modo            ModoPeso
  qtd             Decimal    @db.Decimal(12, 3)
  peso            Decimal    @db.Decimal(12, 3)
  pesos           Decimal[]  @db.Decimal(12, 3)
  preco           Decimal    @db.Decimal(14, 2)
  base            BaseArroba @default(vivo)
  aplicarDesconto Boolean    @default(false)
  // fração (0.1 = 10%); só venda
  desconto        Decimal?   @db.Decimal(7, 6)
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @db.Timestamptz(3)
  deletedAt       DateTime?  @db.Timestamptz(3)

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@unique([fazendaId, tipo, numero])
  @@index([fazendaId, updatedAt])
}

model Cenario {
  id         String    @id @db.Uuid
  fazendaId  String    @db.Uuid
  nome       String
  // data de criação do cenário (vinda do cliente, preserva a data de quando foi salvo offline)
  criadoEm   DateTime  @db.Timestamptz(3)
  // snapshots imutáveis: objetos JSON cujas folhas são strings decimais (nunca number)
  entradas   Json
  variantes  Json
  parametros Json
  resultado  Json
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@index([fazendaId, criadoEm])
  @@index([fazendaId, updatedAt])
}

// Entradas do simulador da recria: uma por fazenda (campos como string decimal).
model RecriaEntrada {
  id             String    @id @db.Uuid
  fazendaId      String    @unique @db.Uuid
  entradas       Json
  lotacaoInicial String
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
}
