// T-04 (ADR-0010): contas, sessões e fazenda (tenant).
// Convenção de entidade sincronizável (ADR-0007) aplicada à Fazenda: id UUID, version, updatedAt
// do servidor, deletedAt (tombstone). Entidades de negócio futuras repetem a convenção + fazendaId.
generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  // normalizado (trim + minúsculas) na borda; único
  email        String   @unique
  // string PHC argon2id; nulo quando o usuário só entra com Google (T-16)
  senhaHash    String?
  // nome de exibição (RF-004); opcional até o usuário preencher na Conta
  nome         String?
  // RNF-009: versão (AAAA-MM-DD) dos Termos/Política aceita e quando; nulos = nunca aceitou
  aceiteTermosVersao String?
  aceiteTermosEm     DateTime? @db.Timestamptz(3)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  sessoes Sessao[]
  fazenda Fazenda?
  tokensRedefinicao TokenRedefinicao[]
  identidadeGoogle  IdentidadeGoogle?
}

// Identidade Google vinculada (RF-001/RF-006): no máximo uma por conta e um `sub` por conta.
model IdentidadeGoogle {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @unique @db.Uuid
  // identificador estável do Google (claim `sub`)
  sub       String   @unique
  email     String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Sessao {
  // parte pública do token (id.segredo); o segredo nunca é guardado, só o SHA-256 dele (hex)
  id                  String   @id
  segredoHash         String
  usuarioId           String   @db.Uuid
  criadaEm            DateTime @default(now()) @db.Timestamptz(3)
  ultimaVerificacaoEm DateTime @default(now()) @db.Timestamptz(3)
  // teto absoluto
  expiraEm            DateTime @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// RF-002 (ADR-0010): redefinição de senha por e-mail. O token (aleatório, enviado por e-mail) nunca
// é guardado, só o SHA-256 dele (hex). Uso único (`usadoEm`) e validade curta (`expiraEm`).
model TokenRedefinicao {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  usuarioId String    @db.Uuid
  criadoEm  DateTime  @default(now()) @db.Timestamptz(3)
  expiraEm  DateTime  @db.Timestamptz(3)
  usadoEm   DateTime? @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Fazenda {
  id        String    @id @default(uuid()) @db.Uuid
  // único = 1 fazenda por conta na v1 (v1.1: remover a unicidade)
  donoId    String    @unique @db.Uuid
  // opcional até o onboarding (T-05)
  nome      String?
  // área em hectares (RF-011); string decimal na API
  areaHa    Decimal?  @db.Decimal(12, 2)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  dono Usuario @relation(fields: [donoId], references: [id], onDelete: Restrict)

  lotes         Lote[]
  cenarios      Cenario[]
  historicoSync HistoricoSync[]
  recriaEntrada RecriaEntrada?

  @@index([updatedAt])
}

// E3 (ADR-0007, ADR-0011 §3-4): dados do site no servidor, por fazenda. Convenção sincronizável:
// `id` UUID gerado pelo cliente, `version` e `updatedAt` só do servidor, `deletedAt` = lápide.
// Decimais: Decimal exato (ADR-0003); a API os trafega como string canônica.
enum LoteTipo {
  compra
  venda
}

enum ModoPeso {
  total
  medio
  individual
}

enum BaseArroba {
  vivo
  carcaca
}

model Lote {
  id              String     @id @db.Uuid
  fazendaId       String     @db.Uuid
  tipo            LoteTipo
  // max+1 dos lotes ativos por fazenda + tipo; lápides preservam o número sem reservá-lo
  numero          Int
  categoria       String
  data            DateTime?  @db.Date
  modo            ModoPeso
  qtd             Decimal    @db.Decimal(12, 3)
  peso            Decimal    @db.Decimal(12, 3)
  pesos           Decimal[]  @db.Decimal(12, 3)
  preco           Decimal    @db.Decimal(14, 2)
  base            BaseArroba @default(vivo)
  aplicarDesconto Boolean    @default(false)
  // LEGADO (fração, 0.1 = 10%): não é mais lido nem escrito (ADR-0013); remoção exige ADR própria
  desconto        Decimal?   @db.Decimal(7, 6)
  // kg descontados por cabeça (ADR-0013); só venda
  descontoKg      Decimal?   @db.Decimal(8, 3)
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @db.Timestamptz(3)
  deletedAt       DateTime?  @db.Timestamptz(3)

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  // Unicidade parcial dos ativos definida em SQL: Lote_fazendaId_tipo_numero_ativo_key.
  @@index([fazendaId, updatedAt])
  @@index([fazendaId, updatedAt, id])
}

model Cenario {
  id         String    @id @db.Uuid
  fazendaId  String    @db.Uuid
  nome       String
  // data de criação do cenário (vinda do cliente, preserva a data de quando foi salvo offline)
  criadoEm   DateTime  @db.Timestamptz(3)
  // snapshots imutáveis: objetos JSON cujas folhas são strings decimais (nunca number)
  entradas   Json
  variantes  Json
  parametros Json
  resultado  Json
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@index([fazendaId, criadoEm])
  @@index([fazendaId, updatedAt])
  @@index([fazendaId, updatedAt, id])
}

// Entradas do simulador da recria: uma por fazenda (campos como string decimal).
model RecriaEntrada {
  id             String    @id @db.Uuid
  fazendaId      String    @unique @db.Uuid
  entradas       Json
  lotacaoInicial String
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
}

// Versoes preservadas antes da resolucao automatica; nunca dependem do armazenamento do navegador.
model HistoricoSync {
  id         String   @db.Uuid
  fazendaId  String   @db.Uuid
  entidadeId String   @db.Uuid
  tipo       String
  motivo     String
  local      Json
  servidor   Json
  resultado  Json
  criadoEm   DateTime @default(now()) @db.Timestamptz(3)
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@id([fazendaId, id])
  @@index([fazendaId, entidadeId, criadoEm])
}
