{
  "name": "ogado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @ogado/api --filter @ogado/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:parity": "node scripts/parity.mjs",
    "parity:xlsx": "python references/calculo/verify.py",
    "db:generate": "pnpm --filter @ogado/db generate",
    "db:migrate": "pnpm --filter @ogado/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.13.1"
}
