# Copie para .env (ignorado pelo git). Valores abaixo servem só para desenvolvimento local.
POSTGRES_USER=ogado
POSTGRES_PASSWORD=ogado_dev
POSTGRES_DB=ogado
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ogado:ogado_dev@localhost:5432/ogado?schema=public

API_PORT=3001
API_HOST=0.0.0.0
# Origem(ns) permitida(s) no CORS, separadas por vírgula
WEB_ORIGIN=http://localhost:3000

# URL pública da API vista pelo navegador/servidor web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Ambiente da API (obrigatório; sem default). Só development e test são não produtivos: qualquer
# outro valor (production, staging...) liga cookie Secure/__Host- e HSTS.
NODE_ENV=development
# Sessão (ADR-0010): dias de inatividade e teto absoluto
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# argon2id: mínimo OWASP (19 MiB, t=2, p=1); só pode subir
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Rate limit
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN_IP_EMAIL_PER_MIN=5
RATE_LIMIT_LOGIN_IP_PER_MIN=20
RATE_LIMIT_SIGNUP_IP_PER_HOUR=5
# IP/CIDR do proxy reverso confiável, separados por vírgula (ex.: 10.0.0.0/8). NÃO use o IP do
# cliente. OBRIGATÓRIO em produção: sem valor a API não sobe; use `none` para declarar que não há proxy.
# Fora de produção, vazio = não confia em proxy.
TRUST_PROXY=
